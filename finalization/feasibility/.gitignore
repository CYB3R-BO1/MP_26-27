# Fresh local environments and generated bytecode are machine-specific.
.conda/
scripts/__pycache__/
**/__pycache__/

# Public research artifacts are pinned in ARTIFACT_MANIFEST.md. Keeping the
# clones here would embed nested Git repositories and duplicate upstream data.
artifacts/

# Retain lightweight manifests, but not downloaded compilers/prover binaries.
environment/*
!environment/*.txt
!environment/*.json

# This directory is reserved for ad-hoc setup logs; measured run logs live in
# results/ and are committed.
logs/
